# Stake Affiliate API token (Affiliate Program → API). Server-side only —
# never prefix it with VITE_, or it would be bundled into the browser code.
STAKE_API_TOKEN=

# Optional: override the Stake endpoint (e.g. a local mock for testing)
# STAKE_API_URL=https://api.stake.com/affiliate/leaderboard

# Discord OAuth (login). Redirects on the Discord app:
#   http://localhost:5173/api/auth/discord/callback
#   https://kingkulbik.vercel.app/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Kick OAuth (link a Kick account; scope user:read). Redirects on the Kick app:
#   http://localhost:5173/api/auth/kick/callback
#   https://kingkulbik.vercel.app/api/auth/kick/callback
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Signs the login cookie: any long random string (e.g. `openssl rand -base64 48`)
SESSION_SECRET=

# BotRix bid token: the Item Store takes and refunds King Points with it, and the
# admin King Points panel adds and takes them (botrix.live/api/extension/substractPoints).
# Keep it secret: anyone with it can change viewers' points.
BOTRIX_BID=

# Optional: override the Stake API origin used for linking usernames (e.g. a local mock)
# STAKE_API_BASE=https://api.stake.com

# Admin panel (/admin): Discord user ids, comma separated. Open /admin signed in to see yours.
ADMIN_DISCORD_IDS=

# ---------------------------------------------------------------- data
# The database (players, bets, shop, raffles, events). On the VPS,
# deploy/postgres.sh creates one on the server and fills this in. A Neon
# address (*.neon.tech) also works. Without it everything is kept in files
# under DATA_DIR instead.
DATABASE_URL=

# Optional: Vercel Blob token. Set it to keep admin image uploads in the same
# Blob store as on Vercel (older uploads live there). Without it, uploads are
# saved under DATA_DIR/uploads on this server.
# BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------- VPS only
# Where file data and uploads go (the systemd service may write only here)
DATA_DIR=/var/lib/kingkulbik
# The Node server listens on 127.0.0.1:PORT; nginx forwards to it (deploy/nginx.conf)
PORT=3000
# The public address, so sign-in redirects always come back to the real site.
# Add https://<domain>/api/auth/discord/callback and .../api/auth/kick/callback
# as redirects on the Discord and Kick apps.
# AUTH_URL=https://yourdomain.com

# The public address used in search and share tags (canonical links, link
# previews, sitemap.xml). Read when the site is built; falls back to AUTH_URL,
# then https://kingkulbik.vercel.app. Set it on Vercel too once a domain is live.
# SITE_URL=https://yourdomain.com
